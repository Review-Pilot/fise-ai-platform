{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fise-ai-platform",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "WEBSITE_STUDIO_ADMIN_EMAILS": "sebslabbert1@gmail.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "d7525ca1-97db-4b52-a036-fd9b05aa780d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fise-ai-platform-files"
    }
  ],
  "services": [
    {
      "binding": "REVIEW_PILOT_SITE",
      "service": "review-pilot-website-production"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SCAN_QUEUE",
        "queue": "fise-website-scans"
      }
    ],
    "consumers": [
      {
        "queue": "fise-website-scans",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "fise-website-scans-dlq"
      }
    ]
  }
}

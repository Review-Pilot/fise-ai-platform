{
  "name": "fise-ai-platform",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "d7525ca1-97db-4b52-a036-fd9b05aa780d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fise-ai-platform-files"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "services": [
    {
      "binding": "REVIEW_PILOT_SITE",
      "service": "review-pilot-website",
      "environment": "production"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SCAN_QUEUE",
        "queue": "fise-website-scans"
      }
    ]
  }
}
# Copy to .env and fill in. Never commit .env.

# --- App ---
# The public URL of this app. Email images, unsubscribe links and landing pages are served from it,
# so in production this must be HTTPS on YOUR domain (e.g. https://outreach.fise.co.za).
PUBLIC_BASE_URL=http://localhost:3100
# Login password for the app (leave empty only for local use).
APP_PASSWORD=
# Long random string used to sign sessions and unsubscribe links: openssl rand -hex 32
APP_SECRET=
# Other domains you own that email links may point to (comma separated), e.g. fise.co.za
ALLOWED_LINK_DOMAINS=
# Where the SQLite database, images and screenshots live (default ./data)
# DATA_DIR=./data

# --- Claude (copy, research summaries, call scripts) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Google Places API (New): enable "Places API (New)" in Google Cloud ---
GOOGLE_PLACES_API_KEY=

# --- Email via Resend (https://resend.com) ---
RESEND_API_KEY=
# Signing secret of the Resend webhook pointing at ${PUBLIC_BASE_URL}/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Use a SUBDOMAIN for outreach, never your main domain.
SENDING_DOMAIN=mail.example.co.za
FROM_EMAIL="Your Name <you@mail.example.co.za>"
# Where replies go (should be the inbox you connect below)
REPLY_TO_EMAIL=you@mail.example.co.za
# DKIM selector Resend uses (normally "resend")
# DKIM_SELECTOR=resend

# --- Reply tracking over IMAP (Gmail: enable IMAP + create an app password) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Vapi AI calls (optional) ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# An assistant you create in the Vapi dashboard whose system prompt is just: {{callBrief}}
VAPI_ASSISTANT_ID=
# Shared secret; Vapi sends it as X-Vapi-Secret to ${PUBLIC_BASE_URL}/api/webhooks/vapi
VAPI_WEBHOOK_SECRET=

# --- SMS via Twilio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Free demo chatbots built on the Fise platform (needed for the "Get your free demo" button).
# Same bearer token as the fise-quickstart skill (the Worker's QUICKSTART_ADMIN_TOKEN secret). ---
FISE_QUICKSTART_TOKEN=
# FISE_PLATFORM_URL=https://fise-ai-platform.seb-slabbert1.workers.dev

# --- Misc ---
# Chromium for the chat test and render check. Leave empty to use Playwright's own
# (install once with: npx playwright install chromium)
# CHROMIUM_PATH=
# Extra one-off public holidays (e.g. election days), comma separated YYYY-MM-DD
# EXTRA_HOLIDAYS=2029-05-08
